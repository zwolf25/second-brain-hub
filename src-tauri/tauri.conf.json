{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Second Brain Hub",
  "version": "0.3.1",
  "identifier": "com.zackwolf.second-brain-search",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Second Brain Hub",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown file",
        "role": "Viewer",
        "rank": "Alternate",
        "contentTypes": ["net.daringfireball.markdown"]
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zwolf25/second-brain-hub/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4N0JGQUZCRTUwNEM2MTQKUldRVXhnVGwrL3A3K0NoV240NC9xL1FONVFTKzJ5VkZmQkZjWktnU0RyUVRCWnpLb0RhalZHMFUK"
    }
  }
}
