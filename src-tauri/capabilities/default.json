{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/**" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "claude://*" }, { "url": "ms-settings:*" }]
    },
    "dialog:default",
    "updater:default",
    "process:allow-restart"
  ]
}
